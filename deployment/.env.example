# KaiCall — biến môi trường
#
# Copy thành deployment/local/.env rồi điền giá trị thật. KHÔNG commit .env.
# File này chỉ có TÊN biến + mô tả, không bao giờ có giá trị thật — nó là file
# env DUY NHẤT được commit (.gitignore chặn .env và .env.* ở mọi cấp).
#
# Ở Flutter, biến KHÔNG được đọc lúc chạy: `make dev` và `make deploy` đọc file
# này rồi dựng thành cờ --dart-define lúc build (TECHSTACK.md §6).
# `make doctor` kiểm đúng bốn biến dưới đây.

# --- LiveKit Cloud ---
KAICALL_LIVEKIT_URL=              # wss://<project>.livekit.cloud
KAICALL_LIVEKIT_API_KEY=          # API key của project
KAICALL_LIVEKIT_API_SECRET=       # API secret — CHỈ để ký token ở bản demo

# --- Cờ chặn ---
# Bắt buộc bật thì app mới chịu ký token ngay trong máy. Đây là phanh tay cố ý:
# APK mang theo API secret là ai giải nén ra cũng ký được token vào mọi phòng.
# TUYỆT ĐỐI không bật ở bản release (DECISIONS.md 2026-08-20).
KAICALL_ALLOW_INSECURE_LOCAL_TOKEN=true
